# Copy to .env.local when you are ready to wire Firebase.
# Without this, the app runs in local/demo mode (localStorage).
#
# VITE_FIREBASE_CONFIG must be a JSON string from Firebase project settings
# (Project settings → Your apps → Web). Include storageBucket or Storage uploads fail.
# Example shape (use your real values):
# VITE_FIREBASE_CONFIG={"apiKey":"...","authDomain":"build-a-booking-ai.firebaseapp.com","projectId":"build-a-booking-ai","storageBucket":"build-a-booking-ai.appspot.com","messagingSenderId":"...","appId":"..."}
#
# See docs/firebase-launch-checklist.md for Console steps (Google provider, domains, rules).
VITE_FIREBASE_CONFIG={}
VITE_APP_ID=book-and-buy-v1
VITE_INITIAL_AUTH_TOKEN=
VITE_FIREBASE_APPCHECK_SITE_KEY=
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=
VITE_FIREBASE_VAPID_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# Legacy / unused: Firebase Google sign-in (popup/redirect) is the supported path.
# Leave these blank unless you intentionally add GIS client-side OAuth later.
VITE_GOOGLE_OAUTH_CLIENT_ID=
VITE_GOOGLE_OAUTH_ALLOWED_ORIGINS=

# Platform email is sent from Firebase Functions through Resend.
# Configure these as Firebase Functions secrets/env values before deploy:
# RESEND_API_KEY
# BUILD_A_BOOKING_EMAIL_FROM=Build A Booking <hello@yourdomain.com>
# BUILD_A_BOOKING_EMAIL_REPLY_TO=support@yourdomain.com
# BUILD_A_BOOKING_APP_BASE_URL=https://yourdomain.com

# Launch-only hosted payment sandbox QA.
# These values are read by npm run payment:sandbox and are never bundled into the browser.
# BAB_PAYMENT_SANDBOX_ALLOW_MUTATION=true
# BAB_FIREBASE_PROJECT_ID=build-a-booking
# BAB_PAYMENT_APP_ID=build-a-booking-v2
# BAB_PAYMENT_BUSINESS_ID=
# BAB_PAYMENT_PUBLIC_SLUG=your-business
# BAB_PAYMENT_PROVIDERS=stripe,yoco,payfast,paystack
# BAB_PAYMENT_AMOUNT_CENTS=100
# BAB_PAYMENT_CURRENCY=ZAR
# BAB_PAYMENT_CUSTOMER_EMAIL=launch-check@example.com
# BAB_PAYMENT_CUSTOMER_NAME=Launch Check
# BAB_PAYMENT_SUCCESS_URL=https://build-a-booking.web.app/#/dashboard/bookings?payment=sandbox&status=success
# BAB_PAYMENT_CANCEL_URL=https://build-a-booking.web.app/#/dashboard/bookings?payment=sandbox&status=cancelled

# Final mobile gate. Set only when the iOS project is present and ready to be launch-gated.
# BAB_REQUIRE_IOS=true
