rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isPasswordAccount() {
      return signedIn() &&
        request.auth.token.firebase != null &&
        request.auth.token.firebase.sign_in_provider == 'password';
    }

    function verifiedSignedIn() {
      return signedIn() &&
        (!isPasswordAccount() || request.auth.token.email_verified == true);
    }

    function isOwner(userId) {
      return verifiedSignedIn() && request.auth.uid == userId;
    }

    function hasStaffAccess(appId, userId) {
      return verifiedSignedIn() &&
        request.auth.token.email != null &&
        firestore.exists(/databases/(default)/documents/artifacts/$(appId)/staffAccess/$(request.auth.token.email)/workspaces/$(userId)) &&
        firestore.get(/databases/(default)/documents/artifacts/$(appId)/staffAccess/$(request.auth.token.email)/workspaces/$(userId)).data.status == 'active';
    }

    function canManageWorkspaceAsset(appId, userId) {
      return isOwner(userId) || hasStaffAccess(appId, userId);
    }

    function isThreadParticipant(appId, threadData) {
      return verifiedSignedIn() &&
        threadData.ownerId is string &&
        (
          canManageWorkspaceAsset(appId, threadData.ownerId) ||
          (request.auth.token.email != null && threadData.clientEmail == request.auth.token.email)
        );
    }

    function canAccessThread(appId, threadId) {
      return firestore.exists(/databases/(default)/documents/artifacts/$(appId)/clientThreads/$(threadId)) &&
        isThreadParticipant(appId, firestore.get(/databases/(default)/documents/artifacts/$(appId)/clientThreads/$(threadId)).data);
    }

    function isPublicWorkspaceFolder(folder) {
      return folder in ['brand', 'venue', 'services', 'website', 'products', 'social', 'account-avatars'];
    }

    function validImageUpload() {
      return request.resource != null &&
        request.resource.size < 6 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(png|jpeg|jpg|webp|gif|heic|heif)');
    }

    function validVideoUpload() {
      return request.resource != null &&
        request.resource.size <= 48 * 1024 * 1024 &&
        request.resource.contentType.matches('video/.*');
    }

    function validWorkspaceUpload(folder) {
      return validImageUpload() || (folder == 'social' && validVideoUpload());
    }

    function validChatUpload() {
      return request.resource != null &&
        request.resource.size <= 25 * 1024 * 1024 &&
        request.resource.contentType.matches(
          '(image/(png|jpeg|jpg|webp|gif|heic|heif))|' +
          '(application/pdf)|' +
          '(application/msword)|' +
          '(application/vnd\\.openxmlformats-officedocument\\.wordprocessingml\\.document)|' +
          '(application/vnd\\.ms-excel)|' +
          '(application/vnd\\.openxmlformats-officedocument\\.spreadsheetml\\.sheet)|' +
          '(text/(csv|plain))|' +
          '(audio/(webm|mp4|mpeg|wav|ogg|x-m4a))'
        );
    }

    match /artifacts/{appId}/clientThreads/{threadId}/attachments/{messageId}/{fileName} {
      allow read: if canAccessThread(appId, threadId);
      allow create: if canAccessThread(appId, threadId) && validChatUpload();
      allow update, delete: if false;
    }

    match /artifacts/{appId}/users/{userId}/{folder}/{fileName} {
      allow read: if isPublicWorkspaceFolder(folder) || canManageWorkspaceAsset(appId, userId);
      allow create, update: if canManageWorkspaceAsset(appId, userId) && validWorkspaceUpload(folder);
      allow delete: if canManageWorkspaceAsset(appId, userId);
    }

    match /artifacts/{appId}/users/{userId}/{allPaths=**} {
      allow read: if canManageWorkspaceAsset(appId, userId);
      allow create, update: if canManageWorkspaceAsset(appId, userId) && validImageUpload();
      allow delete: if canManageWorkspaceAsset(appId, userId);
    }

    // Scanning and transcoding services own quarantined social originals.
    match /artifacts/{appId}/socialQuarantine/{allPaths=**} {
      allow read, write: if false;
    }
  }
}
