+/* Illustrated industries keep discovery one tap away. */
+.bb-explore-industry-rail {
+  display: flex;
+  gap: 0.5rem;
+  min-width: 0;
+  max-width: 100%;
+  overflow-x: auto;
+  overscroll-behavior-x: contain;
+  scrollbar-width: none;
+  padding: 0.5rem 0 0;
+}
+
+.bb-explore-industry-rail::-webkit-scrollbar {
+  display: none;
+}
+
+.bb-explore-industry-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(5.25rem, 1fr));
+  gap: 0.4rem;
+}
+
+.bb-explore-industry {
+  appearance: none;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: flex-start;
+  flex: 0 0 6rem;
+  min-width: 0;
+  gap: 0.35rem;
+  margin: 0;
+  padding: 0.2rem 0.25rem 0;
+  border: 0;
+  border-radius: 0;
+  background: transparent;
+  color: #667085;
+  font: inherit;
+  text-align: center;
+  cursor: pointer;
+  animation: none;
+  transition: none;
+  transform: none;
+}
+
+.bb-explore-industry::after {
+  content: '';
+  flex: 0 0 auto;
+  width: 1.8rem;
+  height: 3px;
+  margin-top: 0.1rem;
+  border-radius: 999px;
+  background: transparent;
+}
+
+.bb-explore-industry:hover,
+.bb-explore-industry.is-on {
+  color: #101828;
+  background: transparent;
+  transform: none;
+}
+
+.bb-explore-industry.is-on::after {
+  background: #101828;
+}
+
+.bb-explore-industry:focus-visible {
+  outline: 2px solid #667085;
+  outline-offset: -2px;
+  border-radius: 0.6rem;
+}
+
+.bb-explore-industry-art {
+  display: block;
+  flex: 0 0 auto;
+  width: 4.75rem;
+  height: 4.75rem;
+  object-fit: contain;
+  pointer-events: none;
+  user-select: none;
+}
+
+.bb-explore-industry-label {
+  display: block;
+  min-height: 2.1rem;
+  max-width: 100%;
+  font-family: var(--bb-font-body);
+  font-size: 0.78rem;
+  font-weight: 570;
+  line-height: 1.35;
+  letter-spacing: -0.015em;
+}
+
+.bb-explore-industry.is-on .bb-explore-industry-label {
+  font-weight: 720;
+}
+
+.bb-explore-industry-all {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  align-items: center;
+  width: 4.75rem;
+  height: 4.75rem;
+}
+
+.bb-explore-industry-all .bb-explore-industry-art {
+  width: 2.35rem;
+  height: 2.35rem;
+}
+
+.bb-explore-pick-row .bb-explore-industry-art.is-suggestion {
+  width: 2.6rem;
+  height: 2.6rem;
+}
+
+@media (max-width: 599px) {
+  .bb-explore-industry-rail {
+    gap: 0.3rem;
+  }
+
+  .bb-explore-industry {
+    flex-basis: 5rem;
+    gap: 0.3rem;
+  }
+
+  .bb-explore-industry-art,
+  .bb-explore-industry-all {
+    width: 4rem;
+    height: 4rem;
+  }
+
+  .bb-explore-industry-all .bb-explore-industry-art {
+    width: 2rem;
+    height: 2rem;
+  }
+
+  .bb-explore-industry-label {
+    font-size: 0.73rem;
+  }
+}
+
 .bb-explore-pick {
   appearance: none;
   display: inline-flex;
