# Social launches safely on Firebase-only storage/search when these stay false.
SOCIAL_ENFORCE_APP_CHECK=false
SOCIAL_CLOUDFLARE_ENABLED=false
SOCIAL_MANAGED_SAFETY_ENABLED=false
SOCIAL_ALGOLIA_ENABLED=false

# AI gateway. Deploy with connections and funding disabled until configured.
# Keep this APP_ID aligned with VITE_APP_ID and the existing workspace records.
APP_ID=book-and-buy-v1
# Dedicated HTTPS origins. Generated sites cannot share the owner's origin.
APP_PUBLIC_BASE_URL=
WEBSITE_PUBLIC_BASE_URL=
# Create a second Firebase Hosting site and bind hosting target "storefront".
# Optional custom domains must point to that dedicated site, never the owner app.
CUSTOM_DOMAINS_ENABLED=false
CUSTOM_DOMAIN_SITE_ID=
# Optional extra trusted HTTPS payment return origins, comma separated.
PAYMENT_RETURN_ORIGINS=
AI_INCLUDED_PROVIDERS=
AI_INCLUDED_DAILY_TOKENS=0
AI_BYOK_DAILY_TOKENS=500000
AI_MAX_DAILY_RUNS=30
AI_MAX_OUTPUT_TOKENS=8192
AI_MAX_TOOL_STEPS=4
AI_OPENAI_MODELS=gpt-6.1-sol
AI_OPENAI_DEFAULT_MODEL=gpt-6.1-sol
# Unknown models have no thinking control until capabilities are configured.
# AI_OPENAI_MODEL_CAPABILITIES={"your-model":{"efforts":["low","medium","high"],"defaultEffort":"medium"}}

# Commercial ChatGPT sign-in requires an approved registered integration.
# Identity approval alone does not grant ChatGPT plan inference permission.
AI_CHATGPT_OAUTH_ENABLED=false
AI_CHATGPT_INFERENCE_APPROVED=false
# App safeguard only; this is not a ChatGPT plan allowance or reset estimate.
AI_CHATGPT_MAX_DAILY_RUNS=30
OPENAI_CLIENT_ID=
CHATGPT_TOKEN_AUTH_METHOD=none
CHATGPT_REDIRECT_URI=
CHATGPT_RETURN_URL=
AI_CHATGPT_MODELS=gpt-6.1-sol
AI_CHATGPT_DEFAULT_MODEL=gpt-6.1-sol
# Register the exact HTTPS /api/ai/chatgpt callback on the app's first-party
# Hosting origin. Return URL should use the same origin and #/dashboard/settings/ai.
# Use client_secret_basic only when that method is provisioned by OpenAI.

# Store these in Google Secret Manager; never put credentials in this file:
# AI_SETTINGS_ENCRYPTION_KEY (at least 32 random characters)
# OPENAI_API_KEY (set AI_INCLUDED_PROVIDERS=openai and a positive daily allowance)
# OPENAI_CLIENT_SECRET (only for registered client_secret_basic integrations)

# Add provider credentials through Google Secret Manager, never this file:
# CLOUDFLARE_ACCOUNT_ID
# CLOUDFLARE_API_TOKEN
# CLOUDFLARE_WEBHOOK_SECRET
# ALGOLIA_APP_ID
# ALGOLIA_ADMIN_KEY
# ALGOLIA_SOCIAL_INDEX=social_posts
# VERTEX_LOCATION=us-central1
