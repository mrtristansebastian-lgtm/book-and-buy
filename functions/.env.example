# Social launches safely on Firebase-only storage/search when these stay false.
SOCIAL_ENFORCE_APP_CHECK=false
SOCIAL_CLOUDFLARE_ENABLED=false
SOCIAL_MANAGED_SAFETY_ENABLED=false
SOCIAL_ALGOLIA_ENABLED=false

# Add provider credentials through Google Secret Manager, never this file:
# CLOUDFLARE_ACCOUNT_ID
# CLOUDFLARE_API_TOKEN
# CLOUDFLARE_WEBHOOK_SECRET
# ALGOLIA_APP_ID
# ALGOLIA_ADMIN_KEY
# ALGOLIA_SOCIAL_INDEX=social_posts
# VERTEX_LOCATION=us-central1
