rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isPasswordAccount() {
      return signedIn() &&
        request.auth.token.firebase != null &&
        request.auth.token.firebase.sign_in_provider == 'password';
    }

    function verifiedSignedIn() {
      return signedIn() &&
        (!isPasswordAccount() || request.auth.token.email_verified == true);
    }

    function isOwner(userId) {
      return verifiedSignedIn() && request.auth.uid == userId;
    }

    function hasStaffAccess(appId, userId) {
      return verifiedSignedIn() &&
        request.auth.token.email != null &&
        exists(/databases/$(database)/documents/artifacts/$(appId)/staffAccess/$(request.auth.token.email)/workspaces/$(userId)) &&
        get(/databases/$(database)/documents/artifacts/$(appId)/staffAccess/$(request.auth.token.email)/workspaces/$(userId)).data.status == 'active';
    }

    function staffRole(appId, userId) {
      return get(/databases/$(database)/documents/artifacts/$(appId)/staffAccess/$(request.auth.token.email)/workspaces/$(userId)).data.role;
    }

    function staffProfileId(appId, userId) {
      return get(/databases/$(database)/documents/artifacts/$(appId)/staffAccess/$(request.auth.token.email)/workspaces/$(userId)).data.staffId;
    }

    function isOwnStaffCalendar(appId, userId, calendarId) {
      return hasStaffAccess(appId, userId) &&
        calendarId is string &&
        staffProfileId(appId, userId) == calendarId;
    }

    function isOwnStaffCalendarDocument(appId, userId, data) {
      return data.calendarId is string &&
        isOwnStaffCalendar(appId, userId, data.calendarId);
    }

    function canStaff(appId, userId) {
      return isOwner(userId) || hasStaffAccess(appId, userId);
    }

    function canAdmin(appId, userId) {
      return isOwner(userId) || (hasStaffAccess(appId, userId) && staffRole(appId, userId) == 'admin');
    }

    function customClaimAdminFor(userId) {
      return verifiedSignedIn() &&
        request.auth.token.role == 'admin' &&
        (
          request.auth.token.businessId == userId ||
          (request.auth.token.businessIds is list && request.auth.token.businessIds.hasAny([userId]))
        );
    }

    function canPaymentAdmin(appId, userId) {
      return canAdmin(appId, userId) || customClaimAdminFor(userId);
    }

    function isManualPublicGateway(gatewayId) {
      return gatewayId in ['manual_eft', 'cash'];
    }

    function isThreadParticipant(appId, threadData) {
      return verifiedSignedIn() &&
        threadData.ownerId is string &&
        (
          canStaff(appId, threadData.ownerId) ||
          (request.auth.token.email != null && threadData.clientEmail == request.auth.token.email)
        );
    }

    function canAccessThread(appId, threadId) {
      return exists(/databases/$(database)/documents/artifacts/$(appId)/clientThreads/$(threadId)) &&
        isThreadParticipant(appId, get(/databases/$(database)/documents/artifacts/$(appId)/clientThreads/$(threadId)).data);
    }

    function validChatAttachment(appId, threadId, attachment) {
      return attachment is map &&
        attachment.id is string &&
        attachment.id.size() <= 80 &&
        attachment.type in ['image', 'document', 'voice'] &&
        attachment.mimeType is string &&
        attachment.mimeType.size() <= 140 &&
        attachment.name is string &&
        attachment.name.size() <= 120 &&
        attachment.size is number &&
        attachment.size >= 0 &&
        attachment.size <= 25 * 1024 * 1024 &&
        attachment.url is string &&
        attachment.url.size() <= 2048 &&
        attachment.path is string &&
        attachment.path.matches('artifacts/' + appId + '/clientThreads/' + threadId + '/attachments/[^/]+/[^/]+') &&
        attachment.durationMs is number &&
        attachment.durationMs >= 0 &&
        attachment.durationMs <= 5 * 60 * 1000 &&
        attachment.createdAtMs is number;
    }

    function validChatAttachments(appId, threadId, attachments) {
      return attachments is list &&
        attachments.size() <= 4 &&
        (attachments.size() < 1 || validChatAttachment(appId, threadId, attachments[0])) &&
        (attachments.size() < 2 || validChatAttachment(appId, threadId, attachments[1])) &&
        (attachments.size() < 3 || validChatAttachment(appId, threadId, attachments[2])) &&
        (attachments.size() < 4 || validChatAttachment(appId, threadId, attachments[3]));
    }

    function validMessageCreate(appId, threadId) {
      return request.resource.data.text is string &&
        request.resource.data.text.size() <= 3000 &&
        (
          request.resource.data.text.size() > 0 ||
          (request.resource.data.keys().hasAny(['attachments']) && request.resource.data.attachments.size() > 0)
        ) &&
        (
          !request.resource.data.keys().hasAny(['attachments']) ||
          validChatAttachments(appId, threadId, request.resource.data.attachments)
        );
    }

    match /artifacts/{appId}/accounts/{accountId} {
      allow read, create, update: if signedIn() && request.auth.uid == accountId;
      allow delete: if false;
    }

    match /artifacts/{appId}/accountLookup/{email} {
      allow read: if signedIn();
      allow create, update: if signedIn() &&
        request.auth.token.email == email &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.email == email;
      allow delete: if false;
    }

    match /artifacts/{appId}/userProfiles/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() &&
        request.auth.uid == uid &&
        request.resource.data.kind in ['client', 'owner'] &&
        request.resource.data.email is string;
      allow update: if signedIn() &&
        request.auth.uid == uid &&
        request.resource.data.kind == resource.data.kind &&
        request.resource.data.email == resource.data.email;
      allow delete: if false;
    }

    // Canonical social records. Public reads are limited to published, visible
    // content; every interaction and counter mutation is validated by Functions.
    match /artifacts/{appId}/socialPosts/{postId} {
      allow read: if resource.data.status == 'published' &&
        resource.data.moderationState == 'visible';
      allow create, update, delete: if false;

      match /comments/{commentId} {
        allow read: if resource.data.moderationState == 'visible' &&
          get(/databases/$(database)/documents/artifacts/$(appId)/socialPosts/$(postId)).data.status == 'published';
        allow create, update, delete: if false;

        match /reactions/{actorUid} {
          allow read: if signedIn() && request.auth.uid == actorUid;
          allow create, update, delete: if false;
        }
      }

      match /reactions/{actorUid} {
        allow read: if signedIn() && request.auth.uid == actorUid;
        allow create, update, delete: if false;
      }

      match /shares/{shareId} {
        allow read, write: if false;
      }

      match /counterShards/{shardId} {
        allow read, write: if false;
      }
    }

    match /artifacts/{appId}/userProfiles/{uid}/savedPosts/{postId} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    match /artifacts/{appId}/userProfiles/{uid}/following/{slug} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    match /artifacts/{appId}/userProfiles/{uid}/socialFeed/{postId} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    match /artifacts/{appId}/userProfiles/{uid}/socialNotifications/{notificationId} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    match /artifacts/{appId}/users/{ownerId}/socialNotifications/{notificationId} {
      allow read: if canStaff(appId, ownerId);
      allow create, update, delete: if false;
    }

    match /artifacts/{appId}/businessFollows/{slug}/followers/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    match /artifacts/{appId}/socialBusinesses/{slug} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /artifacts/{appId}/socialActivityEvents/{eventId} {
      allow read, write: if false;
    }

    match /artifacts/{appId}/socialRateLimits/{rateLimitId} {
      allow read, write: if false;
    }

    match /artifacts/{appId}/staffAccess/{email}/workspaces/{ownerId} {
      allow read: if signedIn() && (request.auth.token.email == email || canAdmin(appId, ownerId));
      allow create, update: if canAdmin(appId, ownerId) &&
        request.resource.data.ownerId == ownerId &&
        request.resource.data.email == email &&
        request.resource.data.status in ['active', 'revoked'] &&
        request.resource.data.role in ['staff', 'admin'];
      allow delete: if canAdmin(appId, ownerId);
    }

    match /artifacts/{appId}/users/{userId}/config/{docId} {
      allow read: if canStaff(appId, userId);
      allow write: if docId == 'clients'
        ? canStaff(appId, userId)
        : canAdmin(appId, userId);
    }

    match /artifacts/{appId}/users/{userId}/clients/{clientId} {
      allow read, create, update, delete: if canStaff(appId, userId);
    }

    match /artifacts/{appId}/users/{userId}/staff/{staffId} {
      allow read: if canStaff(appId, userId);
      allow create, update, delete: if canAdmin(appId, userId);
    }

    match /artifacts/{appId}/users/{userId}/services/{serviceId} {
      allow read: if canStaff(appId, userId);
      allow create, update, delete: if canAdmin(appId, userId);
    }

    match /artifacts/{appId}/users/{userId}/calendarDefaults/{calendarId} {
      allow read: if canStaff(appId, userId);
      allow create, update: if canAdmin(appId, userId) ||
        (
          isOwnStaffCalendar(appId, userId, calendarId) &&
          request.resource.data.calendarId == calendarId
        );
      allow delete: if canAdmin(appId, userId) ||
        isOwnStaffCalendar(appId, userId, resource.data.calendarId);
    }

    match /artifacts/{appId}/users/{userId}/calendarDays/{calendarDayId} {
      allow read: if canStaff(appId, userId);
      allow create, update: if canAdmin(appId, userId) ||
        isOwnStaffCalendarDocument(appId, userId, request.resource.data);
      allow delete: if canAdmin(appId, userId) ||
        isOwnStaffCalendarDocument(appId, userId, resource.data);
    }

    match /artifacts/{appId}/users/{userId}/availabilityDays/{dateKey}/{document=**} {
      allow read: if canStaff(appId, userId);
      allow write: if false;
    }

    match /artifacts/{appId}/users/{userId}/bookings/{bookingId} {
      allow read, update, delete: if canStaff(appId, userId);
      allow create: if canStaff(appId, userId);
    }

    match /artifacts/{appId}/users/{userId}/clientErrors/{errorId} {
      allow read, delete: if canAdmin(appId, userId);
      allow create: if canStaff(appId, userId) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.ownerId == userId &&
        request.resource.data.error is map &&
        request.resource.data.error.message is string;
      allow update: if false;
    }

    match /artifacts/{appId}/users/{userId}/idempotencyKeys/{keyId} {
      allow read, write: if false;
    }

    match /artifacts/{appId}/users/{userId}/payment_settings/{gatewayId} {
      // Secrets are written only by Cloud Functions (Admin SDK). Clients never read/write here.
      allow read, write: if false;
    }

    match /artifacts/{appId}/users/{userId}/private/{document=**} {
      allow read, write: if false;
    }

    match /artifacts/{appId}/users/{userId}/payment_attempts/{attemptId} {
      allow read: if canPaymentAdmin(appId, userId);
      allow create, update, delete: if false;
    }

    match /artifacts/{appId}/users/{userId}/processed_transactions/{transactionId} {
      allow read: if canPaymentAdmin(appId, userId);
      allow create, update, delete: if false;
    }

    match /artifacts/{appId}/users/{userId}/finance/{financeDoc} {
      allow read: if canPaymentAdmin(appId, userId);
      allow create, update, delete: if false;
    }

    match /artifacts/{appId}/users/{userId}/financeImports/{importId} {
      allow read, create, update, delete: if canPaymentAdmin(appId, userId);
    }

    match /artifacts/{appId}/users/{userId}/notifications/{notificationId} {
      allow read, update, delete: if canStaff(appId, userId);
      allow create: if canStaff(appId, userId) ||
        (
          verifiedSignedIn() &&
          request.auth.token.email != null &&
          request.resource.data.ownerId == userId &&
          request.resource.data.audience == 'owner' &&
          request.resource.data.clientEmail == request.auth.token.email
        );
    }

    match /artifacts/{appId}/clientAccess/{email}/bookings/{bookingId} {
      allow read: if verifiedSignedIn() &&
        (request.auth.token.email == email || (resource.data.ownerId is string && canStaff(appId, resource.data.ownerId)));
      allow create, update: if verifiedSignedIn() &&
        request.resource.data.ownerId is string &&
        canStaff(appId, request.resource.data.ownerId) &&
        request.resource.data.clientEmail == email;
      allow delete: if false;
    }

    match /artifacts/{appId}/clientAccess/{email}/notifications/{notificationId} {
      allow read, update: if verifiedSignedIn() &&
        (request.auth.token.email == email || (resource.data.ownerId is string && canStaff(appId, resource.data.ownerId)));
      allow create: if verifiedSignedIn() &&
        request.resource.data.clientEmail == email &&
        (
          request.auth.token.email == email ||
          (request.resource.data.ownerId is string && canStaff(appId, request.resource.data.ownerId))
        );
      allow delete: if false;
    }

    match /artifacts/{appId}/clientThreads/{threadId} {
      allow read: if isThreadParticipant(appId, resource.data);
      allow create: if verifiedSignedIn() &&
        request.resource.data.ownerId is string &&
        (
          canStaff(appId, request.resource.data.ownerId) ||
          (request.auth.token.email != null && request.resource.data.clientEmail == request.auth.token.email)
        );
      allow update: if isThreadParticipant(appId, resource.data) &&
        request.resource.data.ownerId == resource.data.ownerId &&
        request.resource.data.clientEmail == resource.data.clientEmail;
      allow delete: if canAdmin(appId, resource.data.ownerId);

      match /messages/{messageId} {
        allow read: if canAccessThread(appId, threadId);
        allow create: if canAccessThread(appId, threadId) &&
          validMessageCreate(appId, threadId);
        allow update, delete: if false;
      }
    }

    match /artifacts/{appId}/public/data/workspaces/{slug} {
      allow read: if true;
      allow create, update: if signedIn() &&
        request.resource.data.ownerId is string &&
        canAdmin(appId, request.resource.data.ownerId);
      allow delete: if signedIn() &&
        resource.data.ownerId is string &&
        canAdmin(appId, resource.data.ownerId);

      match /bookingSubmissions/{bookingId} {
        allow read, create, update, delete: if false;
      }

      match /slotLocks/{lockId} {
        allow read, write: if false;
      }

      match /services/{serviceId} {
        allow read: if true;
        allow create, update, delete: if signedIn() &&
          get(/databases/$(database)/documents/artifacts/$(appId)/public/data/workspaces/$(slug)).data.ownerId is string &&
          canAdmin(appId, get(/databases/$(database)/documents/artifacts/$(appId)/public/data/workspaces/$(slug)).data.ownerId);
      }

      match /staff/{staffId} {
        allow read: if true;
        allow create, update, delete: if signedIn() &&
          get(/databases/$(database)/documents/artifacts/$(appId)/public/data/workspaces/$(slug)).data.ownerId is string &&
          canAdmin(appId, get(/databases/$(database)/documents/artifacts/$(appId)/public/data/workspaces/$(slug)).data.ownerId);
      }
    }

    match /artifacts/{appId}/notificationJobs/{jobId} {
      allow read: if signedIn() &&
        resource.data.ownerId is string &&
        canStaff(appId, resource.data.ownerId);
      allow create, update, delete: if false;
    }

    match /artifacts/{appId}/securityRateLimits/{rateLimitId} {
      allow read, write: if false;
    }

    match /artifacts/{appId}/reminderQueue/{jobId} {
      allow read, write: if false;
    }

    match /artifacts/{appId}/billing/{ownerId}/{document=**} {
      allow read: if canAdmin(appId, ownerId);
      allow write: if false;
    }

    function analyticsSessionValid() {
      return request.resource.data.sessionId is string &&
        request.resource.data.sessionId.size() >= 8 &&
        request.resource.data.sessionId.size() <= 80 &&
        request.resource.data.slug is string &&
        request.resource.data.slug.size() >= 1 &&
        request.resource.data.slug.size() <= 120 &&
        request.resource.data.ownerId is string &&
        request.resource.data.ownerId.size() >= 1 &&
        request.resource.data.ownerId.size() <= 128 &&
        request.resource.data.startedAt is number &&
        request.resource.data.lastSeenAt is number &&
        request.resource.data.path is string &&
        request.resource.data.path.size() <= 500;
    }

    function analyticsEventValid() {
      return request.resource.data.type is string &&
        request.resource.data.type in [
          'page_view',
          'product_view',
          'add_to_cart',
          'begin_checkout',
          'purchase',
          'booking_started',
          'booking_confirmed'
        ] &&
        request.resource.data.sessionId is string &&
        request.resource.data.sessionId.size() >= 8 &&
        request.resource.data.sessionId.size() <= 80 &&
        request.resource.data.slug is string &&
        request.resource.data.slug.size() >= 1 &&
        request.resource.data.slug.size() <= 120 &&
        request.resource.data.ownerId is string &&
        request.resource.data.ownerId.size() >= 1 &&
        request.resource.data.ownerId.size() <= 128 &&
        request.resource.data.at is number;
    }

    function analyticsCartValid() {
      return request.resource.data.cartId is string &&
        request.resource.data.cartId.size() >= 8 &&
        request.resource.data.cartId.size() <= 80 &&
        request.resource.data.sessionId is string &&
        request.resource.data.sessionId.size() >= 8 &&
        request.resource.data.sessionId.size() <= 80 &&
        request.resource.data.slug is string &&
        request.resource.data.slug.size() >= 1 &&
        request.resource.data.slug.size() <= 120 &&
        request.resource.data.ownerId is string &&
        request.resource.data.ownerId.size() >= 1 &&
        request.resource.data.ownerId.size() <= 128 &&
        request.resource.data.status in ['active', 'checkout', 'abandoned', 'converted'] &&
        request.resource.data.valueCents is number &&
        request.resource.data.valueCents >= 0 &&
        request.resource.data.valueCents <= 100000000 &&
        request.resource.data.updatedAt is number &&
        request.resource.data.items is list &&
        request.resource.data.items.size() <= 50;
    }

    match /artifacts/{appId}/analyticsSessions/{sessionId} {
      allow create: if analyticsSessionValid() &&
        request.resource.data.sessionId == sessionId;
      allow update: if analyticsSessionValid() &&
        resource.data.sessionId == sessionId &&
        request.resource.data.sessionId == sessionId &&
        request.resource.data.ownerId == resource.data.ownerId &&
        request.resource.data.slug == resource.data.slug &&
        request.resource.data.startedAt == resource.data.startedAt;
      allow read: if resource.data.ownerId is string &&
        canStaff(appId, resource.data.ownerId);
      allow delete: if false;
    }

    match /artifacts/{appId}/analyticsEvents/{eventId} {
      allow create: if analyticsEventValid();
      allow read: if resource.data.ownerId is string &&
        canStaff(appId, resource.data.ownerId);
      allow update, delete: if false;
    }

    match /artifacts/{appId}/analyticsCarts/{cartId} {
      allow create: if analyticsCartValid() &&
        request.resource.data.cartId == cartId;
      allow update: if analyticsCartValid() &&
        resource.data.cartId == cartId &&
        request.resource.data.cartId == cartId &&
        request.resource.data.ownerId == resource.data.ownerId &&
        request.resource.data.slug == resource.data.slug &&
        request.resource.data.sessionId == resource.data.sessionId;
      allow read: if resource.data.ownerId is string &&
        canStaff(appId, resource.data.ownerId);
      allow delete: if false;
    }

    match /artifacts/{appId}/analyticsDaily/{docId} {
      allow read: if resource.data.ownerId is string &&
        canStaff(appId, resource.data.ownerId);
      allow write: if false;
    }
  }
}
